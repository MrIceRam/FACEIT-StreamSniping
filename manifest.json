{
  "manifest_version": 3,
  "name": "FACEIT-StreamSniping",
  "short_name": "FSS",
  "version": "1.3",
  "author": "Точно_не_ИИ",
  "description": "StreamSniping-FACEIT",

  "icons": {
    "128": "icons/128.png",
    "48": "icons/48.png",
    "32": "icons/32.png"
  },

  "permissions": ["storage", "notifications", "activeTab"],

  "host_permissions": [
    "https://*.faceit.com/*",
    "https://steamcommunity.com/*",
    "https://www.youtube.com/*"
  ],

  "action": {
    "default_title": "Открыть Игроков",
    "default_icon": "icons/48.png",
    "default_popup": "src/popup/popup.html"
  },

  "background": {
    "service_worker": "src/background/background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://*.faceit.com/*"],
      "js": ["src/content/nickVariations.js", "src/content/showPlayer.js"]
    }
  ]
}

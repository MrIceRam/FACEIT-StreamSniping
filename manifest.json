{
  "manifest_version" : 3,
  "name" : "FACEIT-StreamSniping",
  "short_name" : "FSS",
  "version" : "1.0",
  "author" : "Точно_не_ИИ",
  "description" : "StreamSniping-FACEIT",
  "host_permissions": ["<all_urls>"],

  "icons" : {
    "128" : "ico/128.png",
    "48" : "ico/48.png",
    "32" : "ico/32.png"
  },

  "permissions" : ["storage", "notifications", "activeTab"],

  "action" : {
    "default_title" : "Открыть Игроков",
    "default_icon" : "ico/48.png",
    "default_popup": "html/main.html"
  },

  "background" : {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://*.faceit.com/*"],
      "js": ["nickVariations.js", "showPlayer.js"]
    }
  ]
}